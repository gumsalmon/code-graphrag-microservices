    "excerpt": "    public Optional<Map<String, Object>> findOwner(@PathVariable(\"ownerId\") @Min(1) int ownerId) {\n        return ownerRepository.findById(ownerId).map(owner -> {\n            Map<String, Object> response = new LinkedHashMap<>();\n            response.put(\"id\", owner.getId());\n            response.put(\"firstName\", owner.getFirstName());\n            response.put(\"lastName\", owner.getLastName());\n            response.put(\"address\", owner.getAddress());\n            response.put(\"city\", owner.getCity());\n            response.put(\"telephone\", owner.getTelephone());\n            response.put(\"animals\", owner.getPets());\n            return response;\n        });\n    }"
